# 复制为 backend/.env 并按实际环境填写（.env 已被 gitignore，真实密钥放 .env 不要放这里）

# ===== 数据库：PostgreSQL + pgvector（本地 Linux 上的 PG 服务，pgvector 已启用、512 维）=====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DB=saros

# ===== 主 LLM（OpenAI 兼容协议，DeepSeek 等国产模型）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ===== 音频模式多模态模型（通义，DashScope OpenAI 兼容接口，仅无字幕时启用）=====
# 2026-08 实测：qwen-omni-turbo 已不在控制台展示，改用 qwen3.5-omni-flash（音频输入→文本输出）
# 备选：qwen3.5-omni-plus（质量更高、更贵）
AUDIO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AUDIO_LLM_API_KEY=sk-xxx
AUDIO_LLM_MODEL=qwen3.5-omni-flash

# ===== 嵌入模型（本地 CPU 推理；支持 HF 模型名或本地目录，相对路径基于 backend/）=====
# 网络不通时可从 ModelScope 下载后指向本地：git clone https://www.modelscope.cn/AI-ModelScope/bge-small-zh-v1.5.git
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ===== 搜索源（全部免费；ddgs 主力，bing/baidu 抓取兜底，可裁剪）=====
SEARCH_PROVIDERS=ddgs,bing,baidu

# ===== B 站视频 =====
# cookie 文件路径（相对路径基于 backend/ 目录；下载 403 时提示用户更新）
COOKIE_PATH=data/.cookies.txt
# 视频清晰度上限（720p 封顶，可调低）
MAX_VIDEO_HEIGHT=720
